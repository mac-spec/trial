# Supabase public (web) client credentials.
# Copy this file to `.env.local` and fill in the values from your
# Supabase project: Settings > API.
#
# VITE_SUPABASE_URL must be your project URL, e.g. https://<project-ref>.supabase.co
# (NOT https://supabase.co — that is the marketing site and will fail every request).
#
# VITE_SUPABASE_ANON_KEY must be the real "anon public" JWT from the API tab.
#
# If these are left unset, the dashboard automatically falls back to local
# demo data so the UI still renders.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
