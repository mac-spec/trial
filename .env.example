# Frontend — only public/client-safe values may use VITE_*.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional production Python audit API. Leave blank to use the built-in demo fallback.
VITE_AUDIT_API_URL=https://YOUR-AUDIT-BACKEND.example.com

# Optional: override the Supabase Edge Function URL used by batch_audit.mjs
AUDIT_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/audit-pipeline

# Backend-only secrets — NEVER prefix these with VITE_ and NEVER commit real values.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# GOVT_ALERT_WEBHOOK_URL=YOUR_APPROVED_INTERNAL_WEBHOOK_URL

# Copernicus Data Space — server-side only.
# Add the real values in Vercel/your backend host, never in source control or the browser.
# COPERNICUS_CLIENT_ID=YOUR_COPERNICUS_CLIENT_ID
# COPERNICUS_CLIENT_SECRET=YOUR_COPERNICUS_CLIENT_SECRET
